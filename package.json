{
  "name": "ring-vapi-doorman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Answer the Ring doorbell with a Vapi assistant: button press -> live Ring call -> two-way audio bridge -> Vapi",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "call": "node --env-file=.env src/main.ts --now",
    "doctor": "node --env-file=.env src/tools/doctor.ts",
    "cameras": "node --env-file=.env src/tools/cameras.ts",
    "dings": "node --env-file=.env src/tools/dings.ts",
    "speaker-test": "node --env-file=.env src/tools/speaker-test.ts",
    "auth": "ring-auth-cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ring-client-api": "^14.3.0",
    "werift": "0.22.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
