# Ring — get a token with `npm run auth` (ring-auth-cli). It rotates on use;
# this file is rewritten automatically when that happens.
RING_REFRESH_TOKEN=

# Which device answers. Name substring or numeric id; blank = first doorbell.
RING_CAMERA=

# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Said by the assistant, these end the call (applied per-call, your saved
# assistant config is never modified)
VAPI_END_CALL_PHRASES=goodbye,have a great day,bye for now

# Optional
DEBUG=false
# Fallback ding detection if push notifications stop arriving (seconds, 0 = off)
RING_DING_POLL_SECONDS=0

# --- Call behaviour ---
# Hold the greeting this long after the press so it lands after the chime
CALL_ANSWER_DELAY_MS=4000
# Presses within this window are ignored; a later press hangs up the call
CALL_COOLDOWN_SECONDS=5
# Hard stop for one call
CALL_MAX_SECONDS=300
# Silence the doorbell chime during a call so a second press doesn't blast it
MUTE_CHIME_DURING_CALL=true

# --- Audio ---
# 16000 is Vapi's native band; higher rates only upsample (measured, not guessed)
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=20
# Jitter buffer. Vapi bursts with ~51ms p95 gaps, so 150ms rides through them.
# Raise if choppy, lower for less latency. `npm run vapi-test` prints the gaps.
AUDIO_PREBUFFER_MS=150
# Drop assistant audio buffered beyond this rather than fall behind
AUDIO_MAX_BUFFERED_MS=1500
AUDIO_OPUS_BITRATE=48k
# Faint noise instead of digital silence, so the speaker path never idles
AUDIO_COMFORT_NOISE=true
