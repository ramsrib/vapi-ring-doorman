# Ring — get a token with `npm run auth` (ring-auth-cli). It rotates on use;
# this file is rewritten automatically when that happens.
RING_REFRESH_TOKEN=

# Which device answers. Name substring or numeric id; blank = first doorbell.
RING_CAMERA=

# Vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# Optional
DEBUG=false
# Fallback ding detection if push notifications stop arriving (seconds, 0 = off)
RING_DING_POLL_SECONDS=0
# Audio/latency tuning
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=20
AUDIO_MAX_BUFFERED_MS=400
# Call limits
CALL_MAX_SECONDS=300
CALL_COOLDOWN_SECONDS=15
